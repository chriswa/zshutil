#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["cartesia[websockets]"]
# ///
"""Stream a text/markdown file through Cartesia TTS with real-time playback.

Usage:
    cartesia-read README.md
    cartesia-read -          # read from stdin
    cat notes.md | cartesia-read

Ctrl+C stops immediately — no further text is sent, so you stop spending tokens.

Logs are written to ~/Library/Logs/cartesia-read.log
"""

import asyncio
import io
import logging
import math
import os
import re
import struct
import subprocess
import sys
import tempfile
import time
import wave

from cartesia import AsyncCartesia

# Override per-invocation with CARTESIA_VOICE_ID; falls back to the default voice.
VOICE_ID = os.environ.get("CARTESIA_VOICE_ID") or "f786b574-daa5-4673-aa0c-cbe3e8534c02"
MODEL = "sonic-3"
# Output volume (sonic-3 generation_config control, range 0.5–2.0). Boosted
# above 1.0 by default so quieter voices stay audible; override with CARTESIA_VOLUME.
VOLUME = float(os.environ.get("CARTESIA_VOLUME") or 1.5)
SAMPLE_RATE = 44100
# Cartesia WebSocket contexts silently truncate audio output at ~47 seconds.
# Keep each batch well under that to ensure all text is synthesized.
BATCH_CHAR_LIMIT = 600
# If we don't receive an audio chunk for this long, assume the WS has silently
# stalled (Cartesia sometimes stops sending without closing the connection).
RECV_TIMEOUT_S = 15.0
# Hard cap on a single cartesia-read invocation. Generous enough for the
# 2000-char MCP input cap; prevents orphaned processes if everything else fails.
OVERALL_TIMEOUT_S = 300.0

LOG_PATH = os.path.expanduser("~/Library/Logs/cartesia-read.log")


# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
log = logging.getLogger("cartesia-read")
log.setLevel(logging.DEBUG)
_fh = logging.FileHandler(LOG_PATH)
_fh.setFormatter(logging.Formatter("%(asctime)s  %(message)s", datefmt="%H:%M:%S"))
log.addHandler(_fh)


# ---------------------------------------------------------------------------
# Audio cues — tiny WAV tones played via afplay
# ---------------------------------------------------------------------------

def _make_tone(freq: float, duration_ms: int, volume: float = 0.25) -> bytes:
    """Synthesise a short sine-wave tone and return WAV bytes."""
    sr = 44100
    n = int(sr * duration_ms / 1000)
    fade = int(sr * 0.005)  # 5ms fade to avoid clicks
    samples = []
    for i in range(n):
        env = 1.0
        if i < fade:
            env = i / fade
        elif i > n - fade:
            env = (n - i) / fade
        samples.append(int(volume * env * math.sin(2 * math.pi * freq * i / sr) * 32767))
    buf = io.BytesIO()
    with wave.open(buf, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(sr)
        w.writeframes(struct.pack(f"<{n}h", *samples))
    return buf.getvalue()


def _write_tone_file(name: str, data: bytes) -> str:
    """Write tone WAV to a cache dir so afplay can read it."""
    cache = os.path.join(tempfile.gettempdir(), "cartesia-read-tones")
    os.makedirs(cache, exist_ok=True)
    path = os.path.join(cache, name)
    if not os.path.exists(path):
        with open(path, "wb") as f:
            f.write(data)
    return path


# Pre-generate tone data at import time (< 1ms).
_TONE_START = _make_tone(880, 80, volume=0.2)
_TONE_OK = _make_tone(660, 80, volume=0.2)
_TONE_ERR = _make_tone(330, 150, volume=0.25)


def play_tone(tone_data: bytes, wait: bool = False) -> subprocess.Popen | None:
    """Play a cached tone via afplay. Non-blocking by default."""
    path = _write_tone_file(
        {id(_TONE_START): "start.wav", id(_TONE_OK): "ok.wav", id(_TONE_ERR): "err.wav"}
        .get(id(tone_data), "tone.wav"),
        tone_data,
    )
    try:
        proc = subprocess.Popen(
            ["afplay", path],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if wait:
            proc.wait()
        return proc
    except FileNotFoundError:
        return None


# ---------------------------------------------------------------------------
# Markdown stripping
# ---------------------------------------------------------------------------

def _ensure_punct(line: str) -> str:
    s = line.rstrip()
    if s and not re.search(r"[.!?;:,]$", s):
        s += "."
    return s


def _batch_paragraphs(paragraphs: list[str]) -> list[list[str]]:
    """Group paragraphs into batches that stay under BATCH_CHAR_LIMIT.

    Each batch becomes a separate WebSocket context to avoid the per-context
    audio truncation limit (~47s). A single paragraph that exceeds the limit
    is placed in its own batch.
    """
    batches: list[list[str]] = []
    current: list[str] = []
    current_chars = 0
    for para in paragraphs:
        if current and current_chars + len(para) > BATCH_CHAR_LIMIT:
            batches.append(current)
            current = []
            current_chars = 0
        current.append(para)
        current_chars += len(para)
    if current:
        batches.append(current)
    return batches


def strip_markdown(text: str) -> str:
    text = re.sub(r"```[\s\S]*?```", "", text)
    text = re.sub(r"`([^`]+)`", r"\1", text)
    text = re.sub(r"\*\*(.+?)\*\*", r"\1", text)
    text = re.sub(r"__(.+?)__", r"\1", text)
    text = re.sub(r"\*(.+?)\*", r"\1", text)
    text = re.sub(r"_(.+?)_", r"\1", text)
    text = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", text)
    text = re.sub(
        r"^#{1,6}\s+(.*)", lambda m: _ensure_punct(m.group(1)),
        text, flags=re.MULTILINE,
    )
    text = re.sub(
        r"^>\s+(.*)", lambda m: _ensure_punct(m.group(1)),
        text, flags=re.MULTILINE,
    )
    text = re.sub(
        r"^[\s]*[-*+]\s+(.*)", lambda m: _ensure_punct(m.group(1)),
        text, flags=re.MULTILINE,
    )
    text = re.sub(
        r"^[\s]*\d+\.\s+(.*)", lambda m: _ensure_punct(m.group(1)),
        text, flags=re.MULTILINE,
    )
    text = re.sub(r"^[-*_]{3,}\s*$", "", text, flags=re.MULTILINE)
    text = re.sub(r"\n{3,}", "\n\n", text)
    return text.strip()


# ---------------------------------------------------------------------------
# API key resolution
# ---------------------------------------------------------------------------

def _script_dir() -> str:
    """Return the real directory containing this script (follows symlinks)."""
    return os.path.dirname(os.path.realpath(__file__))


def resolve_api_key() -> str | None:
    key = os.environ.get("CARTESIA_API_KEY")
    if key:
        return key
    env_path = os.path.join(_script_dir(), ".env")
    try:
        with open(env_path) as f:
            for line in f:
                m = re.match(r"^\s*CARTESIA_API_KEY\s*=\s*(.+?)\s*$", line)
                if m:
                    return m.group(1)
    except FileNotFoundError:
        pass
    return None


# ---------------------------------------------------------------------------
# Streaming TTS
# ---------------------------------------------------------------------------

async def _stream_batch(
    ws, batch: list[str], batch_idx: int, batch_count: int, ffplay, t0: float,
) -> tuple[str | None, int, int]:
    """Synthesise one batch through a fresh WS context. Returns (error, chunks, bytes)."""
    ctx = ws.context(
        model_id=MODEL,
        voice={"mode": "id", "id": VOICE_ID},
        generation_config={"volume": VOLUME},
        output_format={
            "container": "raw",
            "encoding": "pcm_f32le",
            "sample_rate": SAMPLE_RATE,
        },
    )
    log.info("batch %d/%d: %d paragraph(s), %d chars",
             batch_idx + 1, batch_count, len(batch), sum(len(p) for p in batch))

    async def push():
        for i, para in enumerate(batch):
            log.info("push: [%d/%d:%d/%d] %s",
                     batch_idx + 1, batch_count, i + 1, len(batch), para[:80])
            await ctx.push(para + " ")
        await ctx.no_more_inputs()

    push_task = asyncio.create_task(push())

    error: str | None = None
    chunks = 0
    total_bytes = 0
    try:
        aiter = ctx.receive().__aiter__()
        while True:
            try:
                resp = await asyncio.wait_for(aiter.__anext__(), timeout=RECV_TIMEOUT_S)
            except StopAsyncIteration:
                break
            except asyncio.TimeoutError:
                error = (
                    f"timeout: no audio chunk for {RECV_TIMEOUT_S:.0f}s "
                    f"(batch {batch_idx + 1}/{batch_count})"
                )
                log.error("recv: %s", error)
                break
            resp_type = getattr(resp, "type", None)
            if resp_type == "error":
                error = getattr(resp, "data", None) or "unknown API error"
                log.error("recv: API error: %s", error)
                break
            audio = getattr(resp, "audio", None)
            if audio:
                if isinstance(audio, str):
                    import base64
                    audio = base64.b64decode(audio)
                chunks += 1
                total_bytes += len(audio)
                if chunks <= 3 or chunks % 10 == 0:
                    log.info("recv: batch %d/%d chunk %d, %d bytes (%.2fs elapsed)",
                             batch_idx + 1, batch_count, chunks, len(audio),
                             time.monotonic() - t0)
                try:
                    ffplay.stdin.write(audio)
                    ffplay.stdin.flush()
                except BrokenPipeError:
                    log.warning("recv: ffplay pipe broken at chunk %d", chunks)
                    error = "ffplay pipe closed"
                    break
    except asyncio.CancelledError:
        pass
    finally:
        push_task.cancel()
        try:
            await push_task
        except (asyncio.CancelledError, Exception):
            pass

    return error, chunks, total_bytes


async def run(paragraphs: list[str], api_key: str) -> str | None:
    """Stream paragraphs through Cartesia TTS. Returns an error message, or None on success."""
    t0 = time.monotonic()
    batches = _batch_paragraphs(paragraphs)
    log.info("start: %d paragraph(s) in %d batch(es), %d chars total",
             len(paragraphs), len(batches), sum(len(p) for p in paragraphs))

    ffplay = subprocess.Popen(
        [
            "ffplay", "-f", "f32le", "-ar", str(SAMPLE_RATE), "-ch_layout", "mono",
            "-nodisp", "-autoexit", "-loglevel", "quiet", "-i", "pipe:0",
        ],
        stdin=subprocess.PIPE,
    )

    client = AsyncCartesia(api_key=api_key)
    error: str | None = None
    total_chunks = 0
    total_bytes = 0

    try:
        log.info("ws: connecting...")
        async with client.tts.websocket_connect() as ws:
            log.info("ws: connected (%.2fs)", time.monotonic() - t0)
            for i, batch in enumerate(batches):
                err, chunks, written = await _stream_batch(
                    ws, batch, i, len(batches), ffplay, t0,
                )
                total_chunks += chunks
                total_bytes += written
                if err:
                    error = err
                    break
            duration_s = total_bytes / (SAMPLE_RATE * 4) if total_bytes else 0
            log.info("done: %d chunks, %d bytes, %.1fs audio, %.2fs wall",
                     total_chunks, total_bytes, duration_s, time.monotonic() - t0)
    except KeyboardInterrupt:
        log.info("interrupted by user (%.2fs)", time.monotonic() - t0)
        ffplay.terminate()
    except Exception as exc:
        error = str(exc)
        log.error("error: %s", error)
    finally:
        try:
            if ffplay.stdin and not ffplay.stdin.closed:
                ffplay.stdin.close()
        except OSError:
            pass
        ffplay.wait()
        log.info("ffplay exited %d (%.2fs wall)", ffplay.returncode, time.monotonic() - t0)

    return error


def main() -> None:
    api_key = resolve_api_key()
    if not api_key:
        print("error: CARTESIA_API_KEY not set (see README.md for setup)",
              file=sys.stderr)
        sys.exit(1)

    if len(sys.argv) < 2 or sys.argv[1] == "-":
        if sys.stdin.isatty():
            print("usage: cartesia-read <file.md>", file=sys.stderr)
            sys.exit(1)
        text = sys.stdin.read()
    else:
        try:
            with open(sys.argv[1]) as f:
                text = f.read()
        except FileNotFoundError:
            print(f"error: file not found: {sys.argv[1]}", file=sys.stderr)
            sys.exit(1)

    stripped = strip_markdown(text)
    paragraphs = [p.strip() for p in stripped.split("\n\n") if p.strip()]
    if not paragraphs:
        print("error: no speakable text after stripping markdown", file=sys.stderr)
        sys.exit(1)

    play_tone(_TONE_START)

    async def _run_with_timeout() -> str | None:
        try:
            return await asyncio.wait_for(run(paragraphs, api_key), timeout=OVERALL_TIMEOUT_S)
        except asyncio.TimeoutError:
            msg = f"overall timeout exceeded ({OVERALL_TIMEOUT_S:.0f}s)"
            log.error(msg)
            return msg

    try:
        error = asyncio.run(_run_with_timeout())
    except KeyboardInterrupt:
        error = None

    if error:
        print(f"error: {error}", file=sys.stderr)
        play_tone(_TONE_ERR, wait=True)
        sys.exit(1)
    else:
        play_tone(_TONE_OK, wait=True)


if __name__ == "__main__":
    main()
