#!/bin/bash
# claude-swap: Switch between Claude Code OAuth accounts
# Usage:
#   claude-swap save <profile>    - Save current tokens to a named profile
#   claude-swap load <profile>    - Load tokens from a named profile
#   claude-swap list              - List saved profiles
#   claude-swap current           - Show current account info

set -euo pipefail

PROFILES_DIR="$HOME/.claude/profiles"
CLAUDE_DIR="$HOME/.claude"
SERVICE="Claude Code-credentials"
ACCOUNT="$(whoami)"

mkdir -p "$PROFILES_DIR"

read_keychain() {
  security find-generic-password -s "$SERVICE" -a "$ACCOUNT" -w 2>/dev/null || echo ""
}

write_keychain() {
  local token_data="$1"
  # Delete existing entry first (ignore errors if not found)
  security delete-generic-password -s "$SERVICE" -a "$ACCOUNT" 2>/dev/null || true
  # Add new entry
  security add-generic-password -s "$SERVICE" -a "$ACCOUNT" -w "$token_data"
}

case "${1:-help}" in
  save)
    profile="${2:?Usage: claude-swap save <profile-name>}"
    token_data=$(read_keychain)
    if [ -z "$token_data" ]; then
      echo "Error: No OAuth tokens found in Keychain. Are you logged in?"
      exit 1
    fi
    echo "$token_data" > "$PROFILES_DIR/$profile.json"
    chmod 600 "$PROFILES_DIR/$profile.json"
    echo "Saved current tokens to profile: $profile"
    ;;

  load)
    profile="${2:?Usage: claude-swap load <profile-name>}"
    profile_file="$PROFILES_DIR/$profile.json"
    if [ ! -f "$profile_file" ]; then
      echo "Error: Profile '$profile' not found."
      echo "Available profiles:"
      ls "$PROFILES_DIR"/*.json 2>/dev/null | xargs -I{} basename {} .json | sed 's/^/  /'
      exit 1
    fi
    token_data=$(cat "$profile_file")
    write_keychain "$token_data"
    echo "Loaded profile: $profile"
    echo "Restart Claude Code for the change to take effect."
    ;;

  list)
    current_tokens=$(read_keychain)
    for f in "$PROFILES_DIR"/*.json; do
      [ -f "$f" ] || continue
      name=$(basename "$f" .json)
      saved_tokens=$(cat "$f")
      if [ "$current_tokens" = "$saved_tokens" ]; then
        echo "* $name"
      else
        echo "- $name"
      fi
    done
    ;;

  current)
    current_tokens=$(read_keychain)
    if [ -z "$current_tokens" ]; then
      echo "No OAuth tokens found (not logged in or using API key)"
      exit 1
    fi
    # Find matching profile name
    matched_profile=""
    for f in "$PROFILES_DIR"/*.json; do
      [ -f "$f" ] || continue
      saved_tokens=$(cat "$f")
      if [ "$current_tokens" = "$saved_tokens" ]; then
        matched_profile=$(basename "$f" .json)
        break
      fi
    done
    if [ -n "$matched_profile" ]; then
      echo "$matched_profile"
    else
      echo "(unsaved profile)"
    fi
    echo "$current_tokens" | python3 -c "
import json, sys
d = json.load(sys.stdin)
oauth = d.get('claudeAiOauth', d)
print(f\"Subscription: {oauth.get('subscriptionType', 'unknown')}\")
print(f\"Rate limit tier: {oauth.get('rateLimitTier', 'unknown')}\")
print(f\"Scopes: {', '.join(oauth.get('scopes', []))}\")
" 2>/dev/null || echo "Token exists but couldn't parse details"
    ;;

  *)
    echo "claude-swap: Switch between Claude Code OAuth accounts"
    echo ""
    echo "Usage:"
    echo "  claude-swap save <profile>    Save current tokens to a named profile"
    echo "  claude-swap load <profile>    Load tokens from a named profile"
    echo "  claude-swap list              List saved profiles"
    echo "  claude-swap current           Show current account info"
    echo ""
    echo "Workflow:"
    echo "  1. Log into work account, run: claude-swap save work"
    echo "  2. /login to personal account, run: claude-swap save personal"
    echo "  3. Switch: claude-swap load work (or personal)"
    ;;
esac
